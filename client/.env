# Frontend environment variables
# All variables exposed to the browser MUST be prefixed with VITE_

# Backend API base URL (used by src/services/api.js)
VITE_API_URL=http://localhost:8000

# Dev server port
VITE_PORT=5173

# Backend origin (used by vite.config.js proxy target)
VITE_BACKEND_ORIGIN=https://event-backend-8i8f.onrender.com
